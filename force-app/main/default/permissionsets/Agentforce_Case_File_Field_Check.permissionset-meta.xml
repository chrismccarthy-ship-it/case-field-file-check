<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Agentforce Case File Field Check</label>
    <description>Lets support reps run the Check Case Files for Missing Fields agent action. Reps also need Einstein prompt template access to run the PDF and image review.</description>
    <hasActivationRequired>false</hasActivationRequired>

    <!-- To make an Employee Agent visible to reps, add an agentAccesses block
         naming that agent's API name, for example:
    <agentAccesses>
        <agent>SDO_Service_Agentforce_Service_Assistant</agent>
        <enabled>true</enabled>
    </agentAccesses>
    -->

    <classAccesses>
        <apexClass>CaseFileFieldAnalyzer</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CaseFileFieldValidator</apexClass>
        <enabled>true</enabled>
    </classAccesses>
</PermissionSet>
